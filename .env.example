# Repository or organisation the runner registers against.
GITHUB_URL=https://github.com/clems4ever/runyard

# Personal access token used to mint runner registration tokens.
#  - classic PAT: scope `repo` for a repository runner, `admin:org` for an org
#    runner
#  - fine-grained PAT: "Administration" repository (or organisation) permission
#    with read & write access
ACCESS_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Alternative to ACCESS_TOKEN: a registration token copied from
# Settings > Actions > Runners > New self-hosted runner. It expires one hour
# after being issued, so the container cannot re-register itself later.
# RUNNER_TOKEN=

# Leave empty to use the container hostname (required when scaling).
RUNNER_NAME=
RUNNER_LABELS=self-hosted-docker
RUNNER_GROUP=Default

# true: accept a single job then exit; `restart: unless-stopped` brings up a
# fresh registration. This is the recommended mode as it gives every job a
# clean workspace.
EPHEMERAL=true

# The runner auto-updates itself by default; set to true to pin the image
# version instead.
DISABLE_UPDATE=false

# Tag of ghcr.io/clems4ever/github-runner to run: "latest", a runner version
# such as "2.336.0", or a commit sha.
IMAGE_TAG=latest

# gid of the docker group on the host, only needed when mounting docker.sock
# (`getent group docker | cut -d: -f3`)
# DOCKER_GID=988
