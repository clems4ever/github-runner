# Runs a self-hosted GitHub Actions runner in a QEMU VM, as a service.
#
# A template unit, so the instance name is the runner name:
#   systemctl enable --now runner-vm@build1
#
# runner-vm.sh is already shaped for this: it runs in the foreground, owns
# exactly one VM, and powers that VM off and deletes its disk when it is
# signalled. So the unit is mostly a matter of getting the shutdown and restart
# semantics right.
#
# Install:
#   sudo install -m 0755 runner-vm.sh /usr/local/bin/runner-vm.sh
#   sudo install -m 0644 systemd/runner-vm@.service /etc/systemd/system/
#   sudo install -d -m 0755 /etc/runner-vm
#   printf 'GITHUB_URL=https://github.com/OWNER/REPO\nGITHUB_TOKEN=ghp_...\n' \
#     | sudo tee /etc/runner-vm/env >/dev/null
#   sudo chmod 0600 /etc/runner-vm/env
#   sudo useradd --system --create-home --home-dir /var/lib/runner-vm runner-vm
#   sudo usermod -aG kvm runner-vm
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now runner-vm@build1
#
# Build the golden image once before the first start, or the first start spends
# a few minutes doing it:
#   sudo -u runner-vm RUNNER_VM_HOME=/var/lib/runner-vm /usr/local/bin/runner-vm.sh build

[Unit]
Description=GitHub Actions runner in a QEMU VM (%i)
Documentation=https://github.com/clems4ever/github-runner
# The runner polls GitHub over the network, so wait for that.
#
# There is deliberately no dependency on dev-kvm.device. systemd only creates
# device units for devices udev tags with "systemd", which covers block, net,
# tty and a few others — never misc, where kvm lives. Requiring it therefore
# fails with "a dependency job for this unit failed" on every host. The script
# checks /dev/kvm itself and says what to do about it, and Restart= retries,
# which also covers a kvm module that loads late.
After=network-online.target
Wants=network-online.target

# A runner that cannot register — a revoked PAT, a repository that no longer
# exists — would otherwise restart every 15 seconds for ever. Ten starts in
# five minutes is well clear of normal ephemeral churn, where each restart
# follows a job. Set StartLimitIntervalSec=0 to lift the limit entirely.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple

# An unprivileged user in the kvm group: the VM needs /dev/kvm, and nothing
# else on the host.
User=runner-vm
SupplementaryGroups=kvm

# Cached images and the VM's disk. StateDirectory creates it with the right
# ownership on every start.
StateDirectory=runner-vm
Environment=RUNNER_VM_HOME=/var/lib/runner-vm
WorkingDirectory=/var/lib/runner-vm

# GITHUB_URL and the long-lived credential live here. systemd reads this file
# as root before dropping to User=, so it can stay 0600 root-owned and the
# credential is never readable by the service user — or by anything a job runs,
# which only ever sees the hour-long registration token minted from it.
EnvironmentFile=/etc/runner-vm/env

# Keeping the credential out of the environment file entirely: put the PAT on
# its own in /etc/runner-vm/pat and uncomment these two. LoadCredential hands
# the service a copy readable only by it, so the file on disk stays 0600
# root-owned, and the token never appears in a command line — where ps would
# show it to every user on the machine — nor in anyone's shell history.
#LoadCredential=pat:/etc/runner-vm/pat
#Environment=GITHUB_TOKEN_FILE=%d/pat

# The same for a GitHub App private key.
#LoadCredential=app.pem:/etc/runner-vm/app.pem
#Environment=GITHUB_APP_PRIVATE_KEY=%d/app.pem
#
# All four stay commented by default because LoadCredential fails the unit when
# its source file is missing, which would break the plain environment-file
# setup.

ExecStart=/usr/local/bin/runner-vm.sh run --name %i

# Every start registers a new runner, because a VM keeps nothing. That needs a
# registration token, and a pasted one expires an hour after it is issued — so
# a service that survives a reboot needs a credential that can mint them:
# either a PAT or a GitHub App. Fail loudly rather than boot a VM that cannot
# register.
ExecStartPre=/bin/sh -c '[ -n "$GITHUB_TOKEN" ] || [ -n "$GITHUB_TOKEN_FILE" ] || [ -n "$GITHUB_APP_ID" ] || { echo "set GITHUB_TOKEN or GITHUB_TOKEN_FILE (a PAT), or GITHUB_APP_ID with GITHUB_APP_PRIVATE_KEY: a pasted registration token expires an hour after it is issued and will not survive a reboot" >&2; exit 1; }'

Restart=always
RestartSec=15

# SIGTERM must reach the script alone. QEMU daemonises itself but stays in the
# service cgroup, so the default KillMode=control-group would signal it
# directly — the equivalent of pulling the VM's power cord — instead of letting
# the script ask the guest to shut down.
KillMode=mixed
KillSignal=SIGTERM

# Stopping is not instant by design: the script asks the guest to power off,
# and the runner inside it finishes the job it is on first. These two allow an
# hour for that, and have to stay in step — SHUTDOWN_TIMEOUT is how long the
# script waits before killing QEMU, TimeoutStopSec how long systemd waits
# before killing the script.
Environment=SHUTDOWN_TIMEOUT=3600
TimeoutStopSec=3660

[Install]
WantedBy=multi-user.target
