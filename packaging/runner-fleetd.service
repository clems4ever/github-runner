# The daemon. Restarting it is safe at any time: it supervises nothing, so
# every runner on this host carries on through it, jobs included.
[Unit]
Description=runner-fleet: self-hosted GitHub Actions runners
Documentation=https://github.com/clems4ever/github-runner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Root, because it writes systemd units and creates virtual machines. The
# runners themselves drop to the runner-fleet user.
User=root
ExecStart=/usr/local/bin/runner-fleet serve --addr 127.0.0.1:8080
Restart=always
RestartSec=5

# The daemon is replaceable; nothing it holds needs to survive it.
KillMode=control-group
TimeoutStopSec=30

# /run/runner-fleet, made by systemd rather than by the daemon.
#
# /run is a tmpfs, so this directory is gone after every boot. The daemon
# creates it itself (paths.EnsureDirs) -- but it never gets the chance, because
# ReadWritePaths= below needs every path it names to EXIST when the mount
# namespace is built, and that happens before ExecStart. The unit then fails at
# step NAMESPACE with status 226, restarting for ever and naming a binary that
# is perfectly present:
#
#   Failed to set up mount namespacing: /run/runner-fleet: No such file or directory
#   Failed at step NAMESPACE spawning /usr/local/bin/runner-fleet: No such file or directory
#
# RuntimeDirectory= is created before the namespace is set up, which is early
# enough, and it is re-made on every boot. It is also implicitly writable, so
# the path comes off ReadWritePaths= rather than being named twice.
RuntimeDirectory=runner-fleet
# 0700, matching paths.EnsureDirs. MkdirAll leaves an existing directory's mode
# alone, so the 0755 default would simply stay 0755 -- the daemon would not
# narrow it. Ownership is still the daemon's to hand over (paths.AgentDirs).
RuntimeDirectoryMode=0700
# Kept when the daemon stops, which is what makes the promise at the top of this
# file true. The decrypted credential a running agent reads lives in here, and
# the default is to delete the directory on stop -- so restarting the daemon
# would take the runners' credentials out from under them, jobs included.
RuntimeDirectoryPreserve=yes

# What it needs and nothing else. It cannot write outside its own directories.
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ReadWritePaths=/etc/runner-fleet /var/lib/runner-fleet /etc/systemd/system

[Install]
WantedBy=multi-user.target
